# API Configuration
# Development (local backend)
#
# Backend `npm run dev` listens on port 3000 (server.cjs: REST + WebSocket /chat on the same host/port).
# Android emulator: use host alias (localhost is the emulator, not your Mac):
#   API_BASE_URL=http://10.0.2.2:3000/api
#   SHARE_LINK_BASE_URL=http://10.0.2.2:3000
# iOS Simulator: http://localhost:3000/api
# Physical phone: LAN IP, e.g. http://192.168.1.5:3000/api
API_BASE_URL=http://localhost:3000/api

# Public origin that serves Next.js /share/[token] and /.well-known/* (must match Android App Links host / iOS applinks).
# Local / Docker:
SHARE_LINK_BASE_URL=http://localhost:3000
# Production (Railway) — use the same host as the backend Next server (not a separate CDN unless it proxies Next):
# SHARE_LINK_BASE_URL=https://tripthread-backend-production.up.railway.app
# API_BASE_URL=https://tripthread-backend-production.up.railway.app/api

# Environment (development | production)
ENVIRONMENT=development

# Google Sign-In (same Web client ID as backend GOOGLE_CLIENT_ID; required for id token verification)
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
