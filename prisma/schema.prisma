generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String            @id @default(uuid())
  email                    String            @unique
  username                 String?           @unique
  name                     String?
  password                 String?
  avatarUrl                String?
  bio                      String?
  isPrivate                Boolean           @default(false)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  deleteMeta               Json?
  deletedAt                DateTime?
  receivedFollowRequests   FollowRequest[]   @relation("ReceivedFollowRequests")
  sentFollowRequests       FollowRequest[]   @relation("SentFollowRequests")
  followers                Follow[]          @relation("Followee")
  following                Follow[]          @relation("Follower")
  refreshTokens            JWTRefreshToken[]
  oauthAccounts            OAuthAccount[]
  passwordResets           PasswordReset[]
  securityEvents           SecurityEvent[]
  tripParticipants         TripParticipant[]
  threadEntries            TripThreadEntry[]
  threadTags               TripThreadTag[]
  trips                    Trip[]
  media                    Media[]
  createdPlaceShares       PlaceShare[]
  sentTripJoinRequests     TripJoinRequest[] @relation("SentTripJoinRequests")
  receivedTripJoinRequests TripJoinRequest[] @relation("ReceivedTripJoinRequests")
  likes                    Like[]            @relation("UserLikes")
  comments                 Comment[]         @relation("UserComments")
  shares                   Share[]           @relation("UserShares")
  finalPosts               TripFinalPost[]

  @@map("users")
}

model PasswordReset {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   Bytes     @unique
  otpCodeHash Bytes?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  createdIp   String?
  userAgent   String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_resets")
}

enum SecurityEventType {
  COMMENT_REPORT
  PROFANITY_DETECTED
  RATE_LIMIT_HIT
  ABUSE_DETECTED
  UNAUTHORIZED_ACCESS
}

model SecurityEvent {
  id         String            @id @default(uuid())
  eventType  SecurityEventType
  userId     String?
  entityType EntityType?
  entityId   String?
  ipAddress  String?
  metadata   Json
  createdAt  DateTime          @default(now())
  user       User?             @relation(fields: [userId], references: [id])

  @@index([eventType, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("security_events")
}

model OAuthAccount {
  id             String        @id @default(uuid())
  provider       OAuthProvider
  providerUserId String
  userId         String
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("oauth_accounts")
}

model Follow {
  id         String   @id @default(uuid())
  followerId String
  followeeId String
  createdAt  DateTime @default(now())
  followee   User     @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)
  follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@map("follows")
}

model FollowRequest {
  id         String              @id @default(uuid())
  followerId String
  followeeId String
  status     FollowRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  followee   User                @relation("ReceivedFollowRequests", fields: [followeeId], references: [id], onDelete: Cascade)
  follower   User                @relation("SentFollowRequests", fields: [followerId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@map("follow_requests")
}

model JWTRefreshToken {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("jwt_refresh_tokens")
}

model Trip {
  id               String            @id @default(uuid())
  userId           String
  title            String
  description      String?
  startDate        DateTime
  endDate          DateTime
  destinations     String[]
  mood             TripMood?
  type             TripType?
  coverMediaId     String?
  status           TripStatus        @default(UPCOMING)
  entryCount       Int               @default(0)
  participantCount Int               @default(1)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  media            Media[]
  finalPosts       TripFinalPost[]
  joinRequests     TripJoinRequest[]
  participants     TripParticipant[]
  threadEntries    TripThreadEntry[]
  coverMedia       Media?            @relation("TripCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeShares      PlaceShare[]

  // Map integration: optional canonical start/end locations and visited places
  startLocationId String?
  startLocation   Place?  @relation("TripStartLocation", fields: [startLocationId], references: [id])
  endLocationId   String?
  endLocation     Place?  @relation("TripEndLocation", fields: [endLocationId], references: [id])

  placeVisits PlaceOnTrip[]

  // Optional precomputed map center/bounds (can be derived server-side)
  centerLat  Float?
  centerLng  Float?
  boundNeLat Float?
  boundNeLng Float?
  boundSwLat Float?
  boundSwLng Float?

  @@map("trips")
}

model TripParticipant {
  id       String   @id @default(uuid())
  tripId   String
  userId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())
  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@map("trip_participants")
}

model TripThreadEntry {
  id             String          @id @default(uuid())
  tripId         String
  authorId       String
  type           ThreadEntryType
  contentText    String?
  mediaId        String?
  locationName   String?
  gpsCoordinates Json?
  createdAt      DateTime        @default(now())
  author         User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media          Media?          @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  trip           Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  taggedUsers    TripThreadTag[]
  likeCount      Int             @default(0)
  commentCount   Int             @default(0)
  // Canonical place link for location/check-in entries
  placeId        String?
  place          Place?          @relation(fields: [placeId], references: [id])

  // Shares
  placeShares PlaceShare[]

  @@map("trip_thread_entries")
}

enum PlaceType {
  POI
  STAY
  FOOD
  TRANSPORT
  VIEWPOINT
  OTHER
}

enum PlaceSource {
  USER
  GOOGLE
  MAPBOX
  APPLE
}

model Place {
  id         String      @id @default(uuid())
  name       String
  address    String?
  lat        Float
  lng        Float
  placeType  PlaceType   @default(POI)
  source     PlaceSource @default(USER)
  externalId String?     @unique
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // Relations
  tripVisits    PlaceOnTrip[]
  threadEntries TripThreadEntry[]
  placeShares   PlaceShare[]
  // Back-relations for Trip start/end
  startTrips    Trip[]            @relation("TripStartLocation")
  endTrips      Trip[]            @relation("TripEndLocation")

  @@index([lat, lng], name: "coordinate_spatial_idx")
  @@index([externalId], name: "external_id_idx")
  @@map("places")
}

model PlaceOnTrip {
  id        String    @id @default(uuid())
  tripId    String
  placeId   String
  visitedAt DateTime?
  dayIndex  Int?
  notes     String?
  order     Int?

  trip  Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id])

  @@unique([tripId, placeId, visitedAt])
  @@index([tripId, visitedAt], name: "trip_visits_idx")
  @@map("places_on_trip")
}

model PlaceShare {
  id            String    @id @default(uuid())
  placeId       String
  tripId        String?
  threadEntryId String?
  token         String    @unique
  expiresAt     DateTime?
  createdById   String
  createdAt     DateTime  @default(now())

  place     Place            @relation(fields: [placeId], references: [id], onDelete: Cascade)
  trip      Trip?            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  entry     TripThreadEntry? @relation(fields: [threadEntryId], references: [id])
  createdBy User             @relation(fields: [createdById], references: [id])

  @@map("place_shares")
}

model TripThreadTag {
  id            String          @id @default(uuid())
  threadEntryId String
  taggedUserId  String
  taggedUser    User            @relation(fields: [taggedUserId], references: [id], onDelete: Cascade)
  threadEntry   TripThreadEntry @relation(fields: [threadEntryId], references: [id], onDelete: Cascade)

  @@unique([threadEntryId, taggedUserId])
  @@map("trip_thread_tags")
}

model TripFinalPost {
  id               String           @id @default(uuid())
  tripId           String
  userId           String
  summaryText      String
  curatedMedia     String[]
  caption          String?
  coverMediaUrl    String?
  generationStatus GenerationStatus @default(DRAFT)
  isPublished      Boolean          @default(false)
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  trip             Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  likeCount        Int              @default(0)
  commentCount     Int              @default(0)
  shareCount       Int              @default(0)

  @@unique([tripId, userId])
  @@index([tripId])
  @@index([userId, isPublished, publishedAt])
  @@map("trip_final_posts")
}

model Media {
  id               String                @id @default(uuid())
  url              String
  publicId         String                @unique // Cloudinary public_id for management
  type             MediaType
  filename         String?
  size             Int?
  width            Int?
  height           Int?
  duration         Float?
  processingStatus MediaProcessingStatus @default(COMPLETED)
  uploadedById     String
  tripId           String?
  createdAt        DateTime              @default(now())

  uploadedBy    User              @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  trip          Trip?             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  threadEntries TripThreadEntry[]
  tripCover     Trip[]            @relation("TripCoverMedia")

  @@map("media")
}

enum MediaProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model TripJoinRequest {
  id         String                @id @default(uuid())
  tripId     String
  senderId   String
  receiverId String
  status     TripJoinRequestStatus @default(PENDING)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  receiver   User                  @relation("ReceivedTripJoinRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User                  @relation("SentTripJoinRequests", fields: [senderId], references: [id], onDelete: Cascade)
  trip       Trip                  @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, receiverId])
  @@map("trip_join_requests")
}

enum OAuthProvider {
  GOOGLE
  APPLE
}

enum FollowRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TripStatus {
  UPCOMING
  ONGOING
  ENDED
}

enum TripMood {
  RELAXED
  ADVENTURE
  SPIRITUAL
  CULTURAL
  PARTY
  MIXED
}

enum TripType {
  SOLO
  GROUP
  COUPLE
  FAMILY
}

enum ThreadEntryType {
  TEXT
  MEDIA
  LOCATION
  CHECKIN
}

enum MediaType {
  IMAGE
  VIDEO
}

enum TripJoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum GenerationStatus {
  DRAFT
  GENERATING
  READY
  PUBLISHED
  FAILED
}

enum EntityType {
  TRIP_FINAL_POST
  TRIP_THREAD_ENTRY
  COMMENT
}

enum ShareType {
  DEEP_LINK
  WEB_LINK
  EXTERNAL
}

model Like {
  id         String     @id @default(uuid())
  userId     String
  entityType EntityType
  entityId   String
  createdAt  DateTime   @default(now())
  user       User       @relation("UserLikes", fields: [userId], references: [id])

  @@unique([userId, entityType, entityId])
  @@index([entityType, entityId, createdAt])
  @@index([userId])
}

model Comment {
  id              String     @id @default(uuid())
  userId          String
  entityType      EntityType
  entityId        String
  contentText     String     @db.VarChar(250)
  parentCommentId String?
  likeCount       Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            User       @relation("UserComments", fields: [userId], references: [id])
  parentComment   Comment?   @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies         Comment[]  @relation("CommentReplies")

  @@index([entityType, entityId, createdAt])
  @@index([parentCommentId])
  @@index([userId])
}

model Share {
  id         String     @id @default(uuid())
  userId     String
  entityType EntityType
  entityId   String
  shareToken String     @unique
  shareType  ShareType
  expiresAt  DateTime?
  metadata   Json
  createdAt  DateTime   @default(now())
  user       User       @relation("UserShares", fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}
