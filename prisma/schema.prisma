generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String            @id @default(uuid())
  email                    String            @unique
  username                 String?           @unique
  name                     String?
  password                 String?
  avatarUrl                String?
  bio                      String?
  isPrivate                Boolean           @default(false)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  deleteMeta               Json?
  deletedAt                DateTime?
  receivedFollowRequests   FollowRequest[]   @relation("ReceivedFollowRequests")
  sentFollowRequests       FollowRequest[]   @relation("SentFollowRequests")
  followers                Follow[]          @relation("Followee")
  following                Follow[]          @relation("Follower")
  refreshTokens            JWTRefreshToken[]
  oauthAccounts            OAuthAccount[]
  passwordResets           PasswordReset[]
  securityEvents           SecurityEvent[]
  tripParticipants         TripParticipant[]
  threadEntries            TripThreadEntry[]
  threadTags               TripThreadTag[]
  trips                    Trip[]
  media                    Media[]
  createdPlaceShares       PlaceShare[]
  sentTripJoinRequests     TripJoinRequest[] @relation("SentTripJoinRequests")
  receivedTripJoinRequests TripJoinRequest[] @relation("ReceivedTripJoinRequests")
  likes                    Like[]            @relation("UserLikes")
  comments                 Comment[]         @relation("UserComments")
  shares                   Share[]           @relation("UserShares")
  sentNotifications        Notification[]    @relation("NotificationActor")
  receivedNotifications    Notification[]    @relation("NotificationRecipient")
  conversationParticipants ConversationParticipant[]
  sentChatMessages         ChatMessage[]     @relation("ChatMessageSender")
  createdExpenses          TripExpense[]     @relation("ExpenseCreatedBy")
  paidExpenses             TripExpense[]     @relation("ExpensePayer")
  expenseShares            TripExpenseShare[]
  settlementsFrom          TripSettlement[]  @relation("SettlementFrom")
  settlementsTo            TripSettlement[]  @relation("SettlementTo")
  recordedSettlements      TripSettlement[]  @relation("SettlementRecordedBy")

  @@map("users")
}

enum NotificationType {
  LIKE
  COMMENT_LIKE
  COMMENT
  COMMENT_REPLY
  TAG
  FOLLOW
}

model Notification {
  id          String           @id @default(uuid())
  type        NotificationType
  actorId     String
  recipientId String
  readAt      DateTime?
  entityType  EntityType?
  entityId    String?
  metadata    Json?
  createdAt   DateTime         @default(now())
  actor       User             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([recipientId, readAt])
  @@map("notifications")
}

model PasswordReset {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   Bytes     @unique
  otpCodeHash Bytes?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  createdIp   String?
  userAgent   String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_resets")
}

enum SecurityEventType {
  COMMENT_REPORT
  PROFANITY_DETECTED
  RATE_LIMIT_HIT
  ABUSE_DETECTED
  UNAUTHORIZED_ACCESS
}

model SecurityEvent {
  id         String            @id @default(uuid())
  eventType  SecurityEventType
  userId     String?
  entityType EntityType?
  entityId   String?
  ipAddress  String?
  metadata   Json
  createdAt  DateTime          @default(now())
  user       User?             @relation(fields: [userId], references: [id])

  @@index([eventType, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("security_events")
}

model OAuthAccount {
  id             String        @id @default(uuid())
  provider       OAuthProvider
  providerUserId String
  userId         String
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("oauth_accounts")
}

model Follow {
  id         String   @id @default(uuid())
  followerId String
  followeeId String
  createdAt  DateTime @default(now())
  followee   User     @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)
  follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@index([followeeId])
  @@map("follows")
}

model FollowRequest {
  id         String              @id @default(uuid())
  followerId String
  followeeId String
  status     FollowRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  followee   User                @relation("ReceivedFollowRequests", fields: [followeeId], references: [id], onDelete: Cascade)
  follower   User                @relation("SentFollowRequests", fields: [followerId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@index([followeeId, status, createdAt(sort: Desc)])
  @@map("follow_requests")
}

model JWTRefreshToken {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("jwt_refresh_tokens")
}

model Trip {
  id               String            @id @default(uuid())
  userId           String
  title            String
  description      String?
  startDate        DateTime
  endDate          DateTime
  destinations     String[]
  mood             TripMood?
  type             TripType?
  coverMediaId     String?
  status           TripStatus        @default(UPCOMING)
  entryCount       Int               @default(0)
  participantCount Int               @default(1)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  media            Media[]
  finalPost        TripFinalPost?
  joinRequests     TripJoinRequest[]
  participants     TripParticipant[]
  threadEntries    TripThreadEntry[]
  coverMedia       Media?            @relation("TripCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeShares      PlaceShare[]

  // Map integration: optional canonical start/end locations and visited places
  startLocationId String?
  startLocation   Place?  @relation("TripStartLocation", fields: [startLocationId], references: [id])
  endLocationId   String?
  endLocation     Place?  @relation("TripEndLocation", fields: [endLocationId], references: [id])

  placeVisits   PlaceOnTrip[]
  conversation  Conversation?  @relation("TripConversation")
  expenses      TripExpense[]
  settlements   TripSettlement[]

  // Expense ledger (v1 tracking)
  expenseCurrency          String  @default("INR")
  totalSpendMinor          Int     @default(0)
  spendVisibleOnDiscover   Boolean @default(false)

  // Optional precomputed map center/bounds (can be derived server-side)
  centerLat  Float?
  centerLng  Float?
  boundNeLat Float?
  boundNeLng Float?
  boundSwLat Float?
  boundSwLng Float?

  @@index([userId, status])
  @@index([status, endDate])
  @@index([status, startDate])
  @@map("trips")
}

model TripParticipant {
  id       String   @id @default(uuid())
  tripId   String
  userId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())
  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([userId])
  @@map("trip_participants")
}

model TripThreadEntry {
  id             String          @id @default(uuid())
  tripId         String
  authorId       String
  type           ThreadEntryType
  contentText    String?
  mediaId        String?
  locationName   String?
  gpsCoordinates Json?
  createdAt      DateTime        @default(now())
  author         User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media          Media?          @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  trip           Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  taggedUsers    TripThreadTag[]
  likeCount      Int             @default(0)
  commentCount   Int             @default(0)
  // Canonical place link for location/check-in entries
  placeId        String?
  place          Place?          @relation(fields: [placeId], references: [id])

  // Shares
  placeShares PlaceShare[]

  @@index([tripId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@map("trip_thread_entries")
}

enum PlaceType {
  POI
  STAY
  FOOD
  TRANSPORT
  VIEWPOINT
  OTHER
}

enum PlaceSource {
  USER
  GOOGLE
  MAPBOX
  APPLE
}

model Place {
  id         String      @id @default(uuid())
  name       String
  address    String?
  lat        Float
  lng        Float
  placeType  PlaceType   @default(POI)
  source     PlaceSource @default(USER)
  externalId String?     @unique
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // Relations
  tripVisits    PlaceOnTrip[]
  threadEntries TripThreadEntry[]
  placeShares   PlaceShare[]
  // Back-relations for Trip start/end
  startTrips    Trip[]            @relation("TripStartLocation")
  endTrips      Trip[]            @relation("TripEndLocation")

  @@index([lat, lng], name: "coordinate_spatial_idx")
  @@index([externalId], name: "external_id_idx")
  @@map("places")
}

model PlaceOnTrip {
  id        String    @id @default(uuid())
  tripId    String
  placeId   String
  visitedAt DateTime?
  dayIndex  Int?
  notes     String?
  order     Int?

  trip  Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id])

  @@unique([tripId, placeId, visitedAt])
  @@index([tripId, visitedAt], name: "trip_visits_idx")
  @@map("places_on_trip")
}

model PlaceShare {
  id            String    @id @default(uuid())
  placeId       String
  tripId        String?
  threadEntryId String?
  token         String    @unique
  expiresAt     DateTime?
  createdById   String
  createdAt     DateTime  @default(now())

  place     Place            @relation(fields: [placeId], references: [id], onDelete: Cascade)
  trip      Trip?            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  entry     TripThreadEntry? @relation(fields: [threadEntryId], references: [id])
  createdBy User             @relation(fields: [createdById], references: [id])

  @@map("place_shares")
}

model TripThreadTag {
  id            String          @id @default(uuid())
  threadEntryId String
  taggedUserId  String
  taggedUser    User            @relation(fields: [taggedUserId], references: [id], onDelete: Cascade)
  threadEntry   TripThreadEntry @relation(fields: [threadEntryId], references: [id], onDelete: Cascade)

  @@unique([threadEntryId, taggedUserId])
  @@map("trip_thread_tags")
}

model TripFinalPost {
  id               String           @id @default(uuid())
  tripId           String           @unique
  summaryText      String
  curatedMedia     String[]
  caption          String?
  coverMediaUrl    String?
  generationStatus GenerationStatus @default(DRAFT)
  isPublished      Boolean          @default(false)
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  trip             Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  likeCount        Int              @default(0)
  commentCount     Int              @default(0)
  shareCount       Int              @default(0)

  @@index([isPublished, createdAt(sort: Desc), id(sort: Desc)])
  @@map("trip_final_posts")
}

model Media {
  id               String                @id @default(uuid())
  url              String
  publicId         String                @unique // Cloudinary public_id for management
  type             MediaType
  filename         String?
  size             Int?
  width            Int?
  height           Int?
  duration         Float?
  processingStatus MediaProcessingStatus @default(COMPLETED)
  uploadedById     String
  tripId           String?
  chatMessageId    String?
  createdAt        DateTime              @default(now())

  uploadedBy    User              @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  trip          Trip?             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  chatMessage   ChatMessage?      @relation(fields: [chatMessageId], references: [id], onDelete: SetNull)
  threadEntries TripThreadEntry[]
  tripCover     Trip[]            @relation("TripCoverMedia")

  @@index([chatMessageId])
  @@index([uploadedById, createdAt(sort: Desc)])
  @@map("media")
}

// ---- Chat ----
enum ConversationType {
  DM
  GROUP
  TRIP
}

enum ConversationParticipantRole {
  MEMBER
  ADMIN
}

model Conversation {
  id        String             @id @default(uuid())
  type      ConversationType
  tripId    String?            @unique
  name      String?
  avatarUrl String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  trip         Trip?                    @relation("TripConversation", fields: [tripId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     ChatMessage[]

  @@index([tripId])
  @@index([type])
  @@map("conversations")
}

model ConversationParticipant {
  id             String                    @id @default(uuid())
  conversationId String
  userId         String
  role           ConversationParticipantRole @default(MEMBER)
  joinedAt       DateTime                 @default(now())
  lastReadAt     DateTime?
  leftAt        DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([userId, lastReadAt])
  @@map("conversation_participants")
}

model ChatMessage {
  id               String    @id @default(uuid())
  conversationId   String
  senderId         String
  content          String    @db.Text
  replyToMessageId String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User          @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo        ChatMessage?  @relation("ChatMessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies        ChatMessage[] @relation("ChatMessageReplies")
  attachments    Media[]

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("chat_messages")
}

enum MediaProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model TripJoinRequest {
  id         String                @id @default(uuid())
  tripId     String
  senderId   String
  receiverId String
  status     TripJoinRequestStatus @default(PENDING)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  receiver   User                  @relation("ReceivedTripJoinRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User                  @relation("SentTripJoinRequests", fields: [senderId], references: [id], onDelete: Cascade)
  trip       Trip                  @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, receiverId])
  @@map("trip_join_requests")
}

enum OAuthProvider {
  GOOGLE
  APPLE
}

enum FollowRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TripStatus {
  UPCOMING
  ONGOING
  ENDED
}

enum TripMood {
  RELAXED
  ADVENTURE
  SPIRITUAL
  CULTURAL
  PARTY
  MIXED
}

enum TripType {
  SOLO
  GROUP
  COUPLE
  FAMILY
}

enum ThreadEntryType {
  TEXT
  MEDIA
  LOCATION
  CHECKIN
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  GIF
}

enum TripJoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum GenerationStatus {
  DRAFT
  GENERATING
  READY
  PUBLISHED
  FAILED
}

enum EntityType {
  TRIP_FINAL_POST
  TRIP_THREAD_ENTRY
  COMMENT
}

enum ShareType {
  DEEP_LINK
  WEB_LINK
  EXTERNAL
}

enum ExpenseCategory {
  FOOD
  STAY
  TRANSPORT
  ACTIVITIES
  SHOPPING
  OTHER
}

enum ExpenseSplitMethod {
  EQUAL
  EXACT
  PERCENT
  SHARES
}

enum TripSettlementStatus {
  PAID
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  DISPUTED
}

model TripExpense {
  id          String             @id @default(uuid())
  tripId      String
  createdById String
  payerId     String
  title       String
  category    ExpenseCategory
  amountMinor Int
  currency    String
  splitMethod ExpenseSplitMethod
  note        String?
  deletedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  trip      Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy User               @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  payer     User               @relation("ExpensePayer", fields: [payerId], references: [id], onDelete: Cascade)
  shares    TripExpenseShare[]

  @@index([tripId, createdAt])
  @@index([tripId, deletedAt])
  @@index([payerId])
  @@map("trip_expenses")
}

model TripExpenseShare {
  id         String @id @default(uuid())
  expenseId  String
  userId     String
  shareMinor Int
  weight     Int?

  expense TripExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@index([userId])
  @@map("trip_expense_shares")
}

model TripSettlement {
  id           String               @id @default(uuid())
  tripId       String
  fromUserId   String
  toUserId     String
  amountMinor  Int
  currency     String
  status       TripSettlementStatus @default(PAID)
  recordedById String
  createdAt    DateTime             @default(now())

  trip       Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fromUser   User @relation("SettlementFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User @relation("SettlementTo", fields: [toUserId], references: [id], onDelete: Cascade)
  recordedBy User @relation("SettlementRecordedBy", fields: [recordedById], references: [id], onDelete: Cascade)

  @@index([tripId, createdAt])
  @@index([fromUserId])
  @@index([toUserId])
  @@map("trip_settlements")
}

model Like {
  id         String     @id @default(uuid())
  userId     String
  entityType EntityType
  entityId   String
  createdAt  DateTime   @default(now())
  user       User       @relation("UserLikes", fields: [userId], references: [id])

  @@unique([userId, entityType, entityId])
  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt(sort: Desc)])
}

model Comment {
  id              String     @id @default(uuid())
  userId          String
  entityType      EntityType
  entityId        String
  contentText     String     @db.VarChar(250)
  parentCommentId String?
  likeCount       Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            User       @relation("UserComments", fields: [userId], references: [id])
  parentComment   Comment?   @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies         Comment[]  @relation("CommentReplies")

  @@index([entityType, entityId, createdAt])
  @@index([parentCommentId, createdAt(sort: Desc)])
  @@index([userId])
}

model Share {
  id         String     @id @default(uuid())
  userId     String
  entityType EntityType
  entityId   String
  shareToken String     @unique
  shareType  ShareType
  expiresAt  DateTime?
  metadata   Json
  createdAt  DateTime   @default(now())
  user       User       @relation("UserShares", fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}
