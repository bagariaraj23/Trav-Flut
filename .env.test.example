# Copy this file to .env.test and fill in values for your local test environment
# Do NOT commit .env.test — it is listed in .gitignore

# Example Postgres test DB (use a local docker/postgres instance for CI parity)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tripthread_test

# Optional explicit test DB var used by some scripts
TEST_DATABASE_URL=${DATABASE_URL}

# JWT secret used during tests
JWT_SECRET=test-secret

# Mapbox token for tests that need it (can be a fake token)
MAPBOX_ACCESS_TOKEN=test-mapbox-token
