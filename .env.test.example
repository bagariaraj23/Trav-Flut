NODE_ENV=test
# Integration tests & seed require TEST_DATABASE_URL. Vitest clears inherited DATABASE_URL and copies TEST_DATABASE_URL only if the Postgres database NAME ends with _test (e.g. tripthread_test).
# Test DB: docker-compose.dev.yml maps host 5433 -> container 5432 (tripthread_test)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/tripthread_test?schema=public"
DATABASE_URL="${TEST_DATABASE_URL}"
TEST_JWT_SECRET="test-jwt-secret-key-for-testing-only"
TEST_MAPBOX_ACCESS_TOKEN="test-mapbox-token"