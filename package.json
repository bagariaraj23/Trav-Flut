{
  "name": "tripthread-backend",
  "version": "1.0.0",
  "description": "TripThread Backend - NextJS + TypeScript + PostgreSQL",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "dotenv -e .env.test -- vitest",
    "test:run": "dotenv -e .env.test -- vitest run",
    "test:coverage": "dotenv -e .env.test -- vitest run --coverage --no-file-parallelism",
    "test:api": "dotenv -e .env.test -- vitest run tests/api --reporter=dot",
    "test:serial": "node scripts/run-integration-serial.mjs",
    "test:scheduler": "dotenv -e .env.test -- vitest run scheduler/tests",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:generate:test": "dotenv -e .env.test -- prisma generate",
    "db:push:test": "dotenv -e .env.test -- prisma db push",
    "db:setup:test": "bash scripts/setup-test-db.sh",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "dotenv -e .env.test -- npx tsx src/scripts/seed.ts",
    "cleanup:resets": "npx tsx src/scripts/cleanupExpiredPasswordResets.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@sendgrid/mail": "^8.1.5",
    "@upstash/redis": "^1.35.6",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "google-auth-library": "^10.5.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.1.6",
    "next": "^15.1.3",
    "pg": "^8.17.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.1",
    "winston": "^3.17.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.19.17",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.7",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "autoprefixer": "^10.4.21",
    "dotenv-cli": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "prisma": "^5.22.0",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.18",
    "typescript": "5.9.2",
    "vitest": "^4.0.15"
  }
}
