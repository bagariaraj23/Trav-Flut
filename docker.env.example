# TripThread — Docker-friendly local development template
# Copy to .env:  cp docker.env.example .env   (or npm run setup:env)
#
# Containers: docker-compose.dev.yml exposes PostgreSQL on localhost:5432 (dev) and :5433 (test).

# --- PostgreSQL (matches docker-compose.dev.yml defaults) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tripthread_dev
POSTGRES_PORT=5432

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tripthread_dev?schema=public"

# Tests use .env.test with TEST_DATABASE_URL; keep this line for tools that read TEST_DATABASE_URL from .env only:
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/tripthread_test?schema=public"

# --- Optional: Upstash Redis REST (see src/env.ts: REDIS_REST_URL, REDIS_REST_TOKEN) ---
# When unset, the API uses in-memory LRU cache only. Local redis:// containers are not used by @upstash/redis.
# REDIS_REST_URL="https://YOUR-UPSTASH-ENDPOINT.upstash.io"
# REDIS_REST_TOKEN="YOUR_TOKEN"

# --- Required for auth (generate strong secrets) ---
# JWT_SECRET=
# JWT_REFRESH_SECRET=

# --- Optional integrations (see .env.example) ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# MAPBOX_ACCESS_TOKEN=
# SENDGRID_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Cloudinary upload presets must exist in the dashboard before signed uploads succeed:
#   tripthread_thread_image, cover, video, avatar
# CLOUDINARY_UPLOAD_FOLDER=tripthread_uploads
# MEDIA_DAILY_UPLOAD_LIMIT=200
# MEDIA_PER_TRIP_LIMIT=500
# MEDIA_TOTAL_STORAGE_LIMIT_BYTES=5368709120
# DELETE_REMOTE_MEDIA=false

# --- Email / app identity (optional) ---
# MAIL_FROM=
# APP_NAME=TripThread
# APP_SCHEME=tripthread
# APP_RESET_WEB_URL=

# Public origin for /share/[token] bridge + /.well-known (mobile SHARE_LINK_BASE_URL should match)
SHARE_LINK_BASE_URL=http://localhost:3000

# --- Full Docker stack (docker-compose.yml) ---
# Backend schema apply on boot:
#   migrate (default) — prisma migrate deploy; volumes created by the old db push entrypoint are baselined once
#   push              — prisma db push (add ALLOW_DATA_LOSS=1 for --accept-data-loss; never on Neon/prod)
#   skip              — do nothing
# DB_SCHEMA_MODE=migrate
# ALLOW_DATA_LOSS=1

# Seconds between scheduler runs. Trip start/end are minute-precision UTC instants.
# SCHEDULER_INTERVAL_SECONDS=300

# Flutter image used by `docker compose --profile test run --rm mobile-tests`
# FLUTTER_IMAGE_TAG=3.38.5   # match the SDK that resolved mobile/pubspec.lock
