# TripThread — Docker-friendly local development template
# Copy to .env:  cp docker.env.example .env   (or npm run setup:env)
#
# Containers: docker-compose.dev.yml exposes PostgreSQL on localhost:5432 (dev) and :5433 (test).

# --- PostgreSQL (matches docker-compose.dev.yml defaults) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tripthread_dev
POSTGRES_PORT=5432

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tripthread_dev?schema=public"

# Tests use .env.test with TEST_DATABASE_URL; keep this line for tools that read TEST_DATABASE_URL from .env only:
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/tripthread_test?schema=public"

# --- Optional: Upstash Redis REST (see src/env.ts: REDIS_REST_URL, REDIS_REST_TOKEN) ---
# When unset, the API uses in-memory LRU cache only. Local redis:// containers are not used by @upstash/redis.
# REDIS_REST_URL="https://YOUR-UPSTASH-ENDPOINT.upstash.io"
# REDIS_REST_TOKEN="YOUR_TOKEN"

# --- Required for auth (generate strong secrets) ---
# JWT_SECRET=
# JWT_REFRESH_SECRET=

# --- Optional integrations (see .env.example) ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# MAPBOX_ACCESS_TOKEN=
# SENDGRID_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
