{
    "name": "tripthread-scheduler",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "start": "ts-node src/index.ts",
        "dev": "nodemon --exec ts-node src/index.ts",
        "build": "tsc",
        "generate": "prisma generate --schema=../prisma/schema.prisma",
        "postinstall": "prisma generate --schema=../prisma/schema.prisma",
        "test": "jest --passWithNoTests",
        "test:watch": "jest --watch",
        "test:unit": "jest tests/tripStatus.unit.test.ts",
        "test:e2e": "REDIS_E2E=1 jest tests/tripStatus.integration.test.ts"
    },
    "dependencies": {
        "bullmq": "^4.12.0",
        "dotenv": "^16.3.1",
        "ioredis": "^5.3.2",
        "winston": "^3.10.0"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^20.8.2",
        "ioredis-mock": "^8.13.0",
        "jest": "^29.7.0",
        "nodemon": "^3.0.1",
        "prisma": "^5.22.0",
        "ts-jest": "^29.4.4",
        "ts-node": "^10.9.1",
        "typescript": "^5.2.2"
    }
}