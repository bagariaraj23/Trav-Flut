# Scheduler environment variables

# Database (required). Use the same production DB as your main app (Neon pooler URL).
# For Neon: use the pooler URL (host contains -pooler). Add ?sslmode=require&connect_timeout=15
# Example (replace with your real URL from Neon dashboard or Railway):
#   DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
# Local dev:
#   DATABASE_URL="postgresql://user:password@localhost:5432/your_db?schema=public"
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB_NAME

# Optional: Redis (scheduler runs without Redis in cron mode)
REDIS_URL=redis://localhost:6379

# Optional: winston log level (error|warn|info|debug)
LOG_LEVEL=info

# Optional: override repeat interval (ms) for dev/testing
# SCHEDULER_REPEAT_EVERY_MS=60000

# Optional: enable Redis-backed e2e test
# REDIS_E2E=1