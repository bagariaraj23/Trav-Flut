{
  "compilerOptions": {
    "target": "ES2020",                 // modern JS
    "module": "commonjs",               // Node.js compatible
    "rootDir": "src",                   // TS source files
    "outDir": "dist",                   // compiled JS output
    "strict": true,                     // enable strict mode
    "esModuleInterop": true,            // allow default imports
    "skipLibCheck": true,               // faster build
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
